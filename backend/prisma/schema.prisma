// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// MODELOS
// ==========================

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String
  email        String        @unique
  password     String?
  googleId     String?       @unique
  rol          Rol           @default(REPARTIDOR)
  estado       EstadoUsuario @default(PENDIENTE)
  creadoEn     DateTime      @default(now())
  repartidor   Repartidor?
  solicitudesCambio SolicitudCambio[]
}

enum Rol {
  ADMIN
  REPARTIDOR
}

enum EstadoUsuario {
  PENDIENTE
  ACTIVO
  RECHAZADO
}

model Repartidor {
  id            Int           @id @default(autoincrement())
  usuarioId     Int           @unique
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  telefono      String?
  vehiculo      String?
  transacciones Transaccion[]
  puntosRetiro  PuntoRetiro[]
  creadoEn      DateTime      @default(now())
}

model Transaccion {
  id                  Int             @id @default(autoincrement())
  repartidorId        Int
  repartidor          Repartidor      @relation(fields: [repartidorId], references: [id])
  tipo                TipoTransaccion
  monto               Decimal         @db.Decimal(10, 2)
  descripcion         String?
  categoriaGasto      String?
  categoriaIngreso    String?
  montoSinDescuento   Decimal?        @db.Decimal(10, 2)
  descuentoAplicado   Decimal?        @db.Decimal(10, 2)
  cantidadPaquetes    Int?
  paquetesFallidos    Int?
  paquetesTotalSalida Int?
  paquetesSobredimensionados Int?
  valorPaquete        Decimal?        @db.Decimal(10, 2)
  montoLiquido        Decimal?        @db.Decimal(10, 2)
  montoIva            Decimal?        @db.Decimal(10, 2)
  observaciones       String?
  sinActividad        Boolean         @default(false)
  turno               Turno?
  fecha               DateTime        @default(now())
  detallesRetiro      DetalleRetiro[]
}

enum TipoTransaccion {
  INGRESO
  GASTO
}

// Turno de la ruta (solo ingresos): AM = mañana, PM = tarde
enum Turno {
  AM
  PM
}

// Catálogo de retiros fijos del repartidor (cliente + zona + precio).
// Se desactivan (activo = false) en vez de borrarse, para no romper el historial.
model PuntoRetiro {
  id           Int             @id @default(autoincrement())
  repartidorId Int
  repartidor   Repartidor      @relation(fields: [repartidorId], references: [id])
  nombre       String
  zona         String
  precio       Decimal         @db.Decimal(10, 2)
  activo       Boolean         @default(true)
  creadoEn     DateTime        @default(now())
  detalles     DetalleRetiro[]

  @@unique([repartidorId, zona, nombre])
}

// Retiros marcados en un registro de ingreso. Guarda copia (snapshot) del nombre,
// zona y precio al momento de registrar, así cambios futuros del catálogo no alteran el historial.
model DetalleRetiro {
  id            Int          @id @default(autoincrement())
  transaccionId Int
  transaccion   Transaccion  @relation(fields: [transaccionId], references: [id], onDelete: Cascade)
  puntoRetiroId Int?
  puntoRetiro   PuntoRetiro? @relation(fields: [puntoRetiroId], references: [id], onDelete: SetNull)
  nombre        String
  zona          String
  precio        Decimal      @db.Decimal(10, 2)

  @@index([transaccionId])
}


// Solicitudes de cambio de datos de perfil. El repartidor NO edita sus datos
// directamente: pide el cambio y un administrador lo aprueba (se aplica) o rechaza.
// "cambios" guarda solo los campos propuestos (nombre, telefono, vehiculo).
// "mensaje" es texto libre para pedidos que el admin resuelve a mano (ej. contraseña, email).
model SolicitudCambio {
  id          Int             @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cambios     Json
  mensaje     String?
  estado      EstadoSolicitud @default(PENDIENTE)
  respuesta   String?
  creadoEn    DateTime        @default(now())
  resueltoEn  DateTime?

  @@index([usuarioId])
  @@index([estado])
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}
